{
  "name": "clinic-management-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env concurrently -n BACKEND,FRONTEND -c blue,green \"bun run server\" \"bun run client\"",
    "server" : "cd \"back-end\" && bun start",
    "client" : "cd \"front-end\" && bun dev"
  },
  "dependencies": {
    "dayjs": "^1.11.13",
    "react": "^19.0.0",
    "react-apexcharts": "^1.7.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "shx": "^0.4.0"
  }
}
